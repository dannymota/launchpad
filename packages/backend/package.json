    "@orpc/server": "2.0.0-beta.50",
    "@orpc/zod": "2.0.0-beta.50",
    "better-auth": "1.7.23",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
