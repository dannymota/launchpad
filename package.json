{
  "name": "launchpad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/web",
    "apps/mcp",
    "packages/*",
    "product"
  ],
  "scripts": {
    "dev": "npm run dev -w @app/web",
    "build": "npm run build -w @app/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "biome ci",
    "format": "biome check --write",
    "test": "vitest run",
    "test:workers": "npm run test:workers -w @app/web",
    "db:generate": "npm run db:generate -w @app/backend",
    "db:migrate:local": "npm run db:migrate:local -w @app/web",
    "check": "npm run lint && npm run typecheck && npm run knip && npm test && npm run test:workers",
    "mcp:test": "node scripts/oauth-test.mjs",
    "theme": "npm run theme -w @app/web && node scripts/build-tokens.mjs",
    "theme:check": "npm run theme && git diff --exit-code -- apps/web/src/themes packages/theme/src/generated",
    "remove": "node scripts/remove.mjs",
    "check:removal": "node scripts/check-removal.mjs",
    "config:apply": "node scripts/config.mjs",
    "config:check": "node scripts/config.mjs --check",
    "access:plan": "node scripts/access.mjs plan",
    "access:apply": "node scripts/access.mjs apply",
    "access:check": "node scripts/access.mjs check",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "check:brief": "node scripts/check-brief.mjs",
    "check:listing": "node scripts/check-listing.mjs",
    "knip": "knip --no-progress",
    "e2e": "npm run build && playwright test",
    "teardown": "node scripts/teardown.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "knip": "6.45.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
