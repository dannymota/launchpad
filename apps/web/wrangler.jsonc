{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "launchpad",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-08",
  // enable_request_signal: oRPC cancels work when a client disconnects. On by default from
  // compatibility date 2026-11-17; drop the flag once the date passes it.
  // global_fetch_strictly_public: the OAuth provider fetches client metadata documents from
  // URLs that clients supply, so fetch must never reach private addresses.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "vars": {
    // What a deployed Worker is. Local runs get APP_ENV=local from .dev.vars, which is never
    // deployed, so a deployed Worker can never run with local shortcuts (plain-http cookies,
    // the mail outbox, a stand-in Access identity). Secrets live in .dev.vars locally and in
    // Worker secrets when deployed.
    "APP_ENV": "production",
    // The address mail is sent from. Empty = no mail, so no email-code sign-in when deployed.
    "EMAIL_FROM": "",
    // Cloudflare Access: the team domain ("acme.cloudflareaccess.com") and this Worker's
    // application audience tags, comma-separated. Empty = internal areas answer 404 to everyone.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // No ids: wrangler finds the database by name and provisions the KV namespace on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launchpad-db",
      "migrations_dir": "../../packages/backend/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
