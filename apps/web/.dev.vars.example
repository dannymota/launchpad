# Local settings for `npm run dev`. Copy to .dev.vars (git-ignored). A new session creates it for you.

# Marks this as a developer machine: plain-http cookies and mail kept in the email_outbox table.
APP_ENV=local

# Signs sessions. Any random string of 32 or more characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# There is no Cloudflare Access on your machine, so say who you are. Internal areas (the whole
# product under the default "private" preset) open as this email. Remove it to see what an
# outsider sees.
DEV_ACCESS_EMAIL=you@example.com

# Admins, when verified by Cloudflare Access. Use the same address to see /admin locally.
ADMIN_EMAILS=you@example.com

# Try the product as it will be after launch, without editing product/product.config.ts:
# DEV_PRESET=public-product

# Optional modules. Each stays off until its settings are filled in; /health shows which are on.

# >>> payments
# Payments (Stripe test mode). The price is the paid plan's, named after its id in the product config.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# <<< payments

# >>> ai
# AI (Claude). Calls stop once the month's budget is spent.
# ANTHROPIC_API_KEY=
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account id>/<gateway>/anthropic
# AI_MONTHLY_BUDGET_USD=10
# AI_PERSON_MONTHLY_BUDGET_USD=2
# <<< ai

# >>> analytics
# Analytics (PostHog). The project key is public; it starts with phc_.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# <<< analytics
