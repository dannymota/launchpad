{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit --incremental false",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "doctor": "astryx doctor --built app",
    "theme": "astryx theme build src/themes/brand/brandTheme.ts"
  },
  "dependencies": {
    "@app/backend": "*",
    "@app/mcp": "*",
    "@app/shared": "*",
    "@app/theme": "*",
    "@astryxdesign/core": "0.7.15",
    "@astryxdesign/theme-neutral": "0.7.15",
    "@stylexjs/stylex": "0.19.2",
    "@vinext/cloudflare": "1.3.4",
    "better-auth": "1.7.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.15",
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "jose": "6.2.17",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  }
}
