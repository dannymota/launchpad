{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "preview": "EXPO_PUBLIC_API_ORIGIN=http://localhost:8099 expo export --platform web --output-dir dist/web && node scripts/preview-web.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.23",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "@orpc/client": "2.0.0-beta.50",
    "better-auth": "1.7.23",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  }
}
